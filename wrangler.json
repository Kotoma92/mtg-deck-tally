{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtg-deck-tally",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "mtg-deck-tally-staging"
    }
  }
}
